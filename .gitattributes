# Normalize line endings: LF in the repository, platform-native on checkout.
* text=auto

# Source files — stored as LF.
*.cs text
*.xaml text
*.csproj text
*.props text
*.json text
*.md text
*.yml text
*.yaml text
*.manifest text
*.config text

# Windows-specific files that should keep CRLF in the working tree.
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries — never convert.
*.ico binary
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.exe binary
*.dll binary
*.pdb binary
