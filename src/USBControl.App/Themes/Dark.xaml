<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== base palette (deep charcoal, layered) ===================== -->

  <Color x:Key="BgColor">#FF0E1014</Color>
  <Color x:Key="TopbarColor">#FF12151B</Color>
  <Color x:Key="CardColor">#FF1A1E26</Color>
  <Color x:Key="CardHoverColor">#FF232834</Color>
  <Color x:Key="FieldColor">#FF12141A</Color>
  <Color x:Key="TextPrimaryColor">#FFE9EDF2</Color>
  <Color x:Key="TextDimColor">#FF8E98A8</Color>

  <!-- AccentBrush / AccentDimBrush / AccentGlowBrush / TopbarGradient / BrandGradient /
       AccentGlowEffect(+) come from the swappable accent dictionary (Accents.cs), which
       rebuilds them frozen on every switch. They must NOT be re-declared here: WPF
       forbids DynamicResource inside Freezables (GradientStop/SolidColorBrush/Effect).
       Consumers reference them with DynamicResource at the setter level. -->

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="TopbarBrush" Color="{StaticResource TopbarColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
  <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
  <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="#FF262B36" />

  <!-- semantic state colors: reserved for device state, never for chrome -->
  <SolidColorBrush x:Key="GoodBrush" Color="#FF3FD08C" />
  <SolidColorBrush x:Key="WarnBrush" Color="#FFEDB44A" />
  <SolidColorBrush x:Key="BadBrush" Color="#FFE2574A" />

  <!-- dotted blueprint grid for the panel-layout canvas (static pen; can't dynamic-bind) -->
  <DrawingBrush x:Key="PanelGridBrush" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,24,24">
    <DrawingBrush.Drawing>
      <GeometryDrawing>
        <GeometryDrawing.Geometry>
          <GeometryGroup>
            <LineGeometry StartPoint="0,0" EndPoint="24,0" />
            <LineGeometry StartPoint="0,0" EndPoint="0,24" />
          </GeometryGroup>
        </GeometryDrawing.Geometry>
        <GeometryDrawing.Pen>
          <Pen Brush="#FF1C212B" Thickness="1" />
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- ===================== buttons ===================== -->

  <Style TargetType="Button">
    <Setter Property="Background" Value="#FF252C3A" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7" Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentDimBrush}" />
              <Setter TargetName="bd" Property="Effect" Value="{DynamicResource AccentGlowEffect}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Effect" Value="{x:Null}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                     To="0.97" Duration="0:0:0.06" />
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                     To="0.97" Duration="0:0:0.06" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.1" />
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.1" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter TargetName="bd" Property="Effect" Value="{x:Null}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- accent-filled call-to-action (Apply profile) -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#FF0B0D11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="7" Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Effect" Value="{DynamicResource AccentGlowStrongEffect}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Effect" Value="{x:Null}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                     To="0.97" Duration="0:0:0.06" />
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                     To="0.97" Duration="0:0:0.06" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.1" />
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.1" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- round enable/disable action button: red = will disable, green = will enable -->
  <Style x:Key="PowerButton" TargetType="Button">
    <Setter Property="Background" Value="#FF57323C" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="19"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.82" />
              <Setter TargetName="bd" Property="Effect" Value="{DynamicResource AccentGlowEffect}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Effect" Value="{x:Null}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                     To="0.94" Duration="0:0:0.06" />
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                     To="0.94" Duration="0:0:0.06" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.1" />
                    <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.1" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsDisabled}" Value="True">
        <Setter Property="Background" Value="#FF2E5C49" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===================== toggle (toolbar state buttons) ===================== -->

  <Style TargetType="ToggleButton">
    <Setter Property="Background" Value="#FF252C3A" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}" />
            <!-- accent pill underline, fades in when checked -->
            <Border x:Name="pill" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom"
                    Margin="8,0,8,2" Background="{DynamicResource AccentBrush}" Opacity="0" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="0,-3,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="pill" Property="Opacity" Value="1" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="pill" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="pill" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== text input ===================== -->

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="bd" Property="Effect" Value="{DynamicResource AccentGlowEffect}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#FF3A4354" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== combo box (full dark template — no more white popup) ===================== -->

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                  Padding="{TemplateBinding Padding}" Margin="3,1">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGlowBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Background="Transparent" BorderThickness="0" Padding="0" />
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                <Path Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                      Data="M0,0 L4.5,4.5 L9,0" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
              <Border Background="#FF181C24" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320"
                      SnapsToDevicePixels="True">
                <Border.Effect>
                  <DropShadowEffect Color="#FF000000" BlurRadius="18" ShadowDepth="3" Opacity="0.55" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,4">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="bd" Property="Effect" Value="{DynamicResource AccentGlowEffect}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== scrollbars (slim, dark) ===================== -->

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="thumb" Background="#FF39404F" CornerRadius="4" Margin="1" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="thumb" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="thumb" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="8" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===================== tooltips & menus ===================== -->

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="#FF1B202A" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="7" Padding="10,6">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="#FF181C24" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="4">
            <Border.Effect>
              <DropShadowEffect Color="#FF000000" BlurRadius="16" ShadowDepth="3" Opacity="0.5" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentDimBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,4" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== HUD status chip (LED dot + uppercase label) ===================== -->

  <!-- tile status pill: border + dot get a per-state color via these variants -->
  <Style x:Key="HudChipBorder" TargetType="Border">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Background" Value="#14101418" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#22FFFFFF" />
  </Style>

  <Style x:Key="HudChipDot" TargetType="Ellipse">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{StaticResource TextDimBrush}" />
  </Style>

  <Style x:Key="HudChipLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- connected / enabled → green -->
  <Style x:Key="ChipOnlineDot" TargetType="Ellipse" BasedOn="{StaticResource HudChipDot}">
    <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
  </Style>
  <Style x:Key="ChipOnlineLabel" TargetType="TextBlock" BasedOn="{StaticResource HudChipLabel}">
    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
  </Style>

  <!-- disabled → red -->
  <Style x:Key="ChipOffDot" TargetType="Ellipse" BasedOn="{StaticResource HudChipDot}">
    <Setter Property="Fill" Value="{StaticResource BadBrush}" />
  </Style>
  <Style x:Key="ChipOffLabel" TargetType="TextBlock" BasedOn="{StaticResource HudChipLabel}">
    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
  </Style>

  <!-- problem → amber -->
  <Style x:Key="ChipIssueDot" TargetType="Ellipse" BasedOn="{StaticResource HudChipDot}">
    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
  </Style>
  <Style x:Key="ChipIssueLabel" TargetType="TextBlock" BasedOn="{StaticResource HudChipLabel}">
    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
  </Style>

  <!-- hub → accent -->
  <Style x:Key="ChipHubDot" TargetType="Ellipse" BasedOn="{StaticResource HudChipDot}">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style x:Key="ChipHubLabel" TargetType="TextBlock" BasedOn="{StaticResource HudChipLabel}">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ===================== checkbox (settings dialog) ===================== -->

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="17" Height="17" CornerRadius="4.5"
                    Background="{StaticResource FieldBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Path x:Name="check" Data="M2.5,8 L6.5,12 L13,4.5" Stroke="#FF0B0D11"
                    StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stretch="None" Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform x:Name="checkScale" ScaleX="0.5" ScaleY="0.5" />
                </Path.RenderTransform>
              </Path>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="check" Property="Opacity" Value="1" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="checkScale" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="checkScale" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="checkScale" Storyboard.TargetProperty="ScaleX"
                                     To="0.5" Duration="0:0:0.1" />
                    <DoubleAnimation Storyboard.TargetName="checkScale" Storyboard.TargetProperty="ScaleY"
                                     To="0.5" Duration="0:0:0.1" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== status-bar status dot / busy spinner ===================== -->

  <!-- Idle: a solid green LED dot. Busy: turns into an accent arc that spins for as
       long as IsBusy stays true (transform animated through the element, which is
       trigger-safe unlike styling a RotateTransform directly). -->
  <Style x:Key="BusySpinner" TargetType="Ellipse">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="StrokeThickness" Value="5" />
    <Setter Property="Stroke" Value="{StaticResource GoodBrush}" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <RotateTransform Angle="0" />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsBusy}" Value="True">
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard RepeatBehavior="Forever"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
              <DoubleAnimation From="0" To="360" Duration="0:0:1.1" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
              <DoubleAnimation To="0" Duration="0:0:0.2" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
