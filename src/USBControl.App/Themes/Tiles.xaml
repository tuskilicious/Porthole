<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svc="clr-namespace:USBControl.App.Services">

  <!-- ============================================================================
       TILES.XAML — the shared port tile, icon well and status chip, plus the value
       converters the views need. The tile is used by both the responsive hub grid and
       the free-form panel canvas. Bind it with:
         <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PortTile}" />
       (Content={Binding} feeds the port view-model in; without it the template
       inflates against a null DataContext and every binding silently fails.)
       ============================================================================ -->

  <svc:PhotoConverter x:Key="PhotoConverter" />
  <svc:PhotoConverter x:Key="GrayPhotoConverter" Grayscale="True" />
  <svc:BoolToVisibilityConverter x:Key="BoolToVis" />
  <svc:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
  <svc:KindToGeometryConverter x:Key="KindToGeometry" />
  <svc:InverseBoolConverter x:Key="InverseBool" />
  <svc:NullToVisibilityConverter x:Key="NullToVis" />

  <!-- device-type glyph (inside the icon well) -->
  <Style x:Key="TileGlyph" TargetType="Path" BasedOn="{StaticResource IconPath}">
    <Setter Property="Width" Value="{StaticResource TypeGlyphSize}" />
    <Setter Property="Height" Value="{StaticResource TypeGlyphSize}" />
    <Setter Property="Stroke" Value="{StaticResource TextDimBrush}" />
    <Setter Property="Data" Value="{Binding DeviceKind, Converter={StaticResource KindToGeometry}}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsDisabled}" Value="True">
        <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsEmpty}" Value="True">
        <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- busy arc inside a status chip -->
  <Style x:Key="ChipSpinner" TargetType="Ellipse">
    <Setter Property="Width" Value="{StaticResource SpinnerSize}" />
    <Setter Property="Height" Value="{StaticResource SpinnerSize}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeDashArray" Value="2.2 1.5" />
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
  </Style>

  <!-- ===================== icon well ===================== -->
  <!-- With a photo: the picture fills the 48x48 well edge to edge, rounded, ringed in accent
       (gray and desaturated when the device is disabled). Without: the type glyph on a
       slightly accent-tinted circle. -->

  <DataTemplate x:Key="IconWell">
    <Grid Width="{StaticResource IconWellSize}" Height="{StaticResource IconWellSize}">

      <Grid Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}">
        <Ellipse Fill="{StaticResource RaisedBrush}" />
        <Ellipse Fill="{DynamicResource AccentTintBrush}" />
        <Ellipse Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
        <Path Style="{StaticResource TileGlyph}" />
      </Grid>

      <Grid Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}">
        <Border CornerRadius="{StaticResource RadiusControl}">
          <Border.Background>
            <ImageBrush ImageSource="{Binding PhotoPath, Converter={StaticResource PhotoConverter}}"
                        Stretch="UniformToFill" />
          </Border.Background>
        </Border>
        <Border x:Name="grayPhoto" CornerRadius="{StaticResource RadiusControl}" Visibility="Collapsed">
          <Border.Background>
            <ImageBrush ImageSource="{Binding PhotoPath, Converter={StaticResource GrayPhotoConverter}}"
                        Stretch="UniformToFill" />
          </Border.Background>
        </Border>
        <Border x:Name="ring" CornerRadius="{StaticResource RadiusControl}" BorderThickness="1"
                BorderBrush="{DynamicResource AccentSelectBrush}" />
      </Grid>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsDisabled}" Value="True">
        <Setter TargetName="grayPhoto" Property="Visibility" Value="Visible" />
        <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ===================== status chip: LED dot + label ===================== -->
  <!-- Connected (green) / Disabled (gray) / Error (red, slow pulse) / Busy (accent spinner) /
       Hub. When the state changes, the chip cross-fades in. -->

  <DataTemplate x:Key="StatusChip">
    <Grid x:Name="chipRoot" HorizontalAlignment="Left" ToolTip="{Binding StatusTooltip}">
      <Border x:Name="chip" CornerRadius="{StaticResource RadiusChip}"
              Background="{StaticResource NeutralSoftBrush}" />
      <!-- error pulse: a red wash that breathes under the label (2s cycle) -->
      <Border x:Name="pulse" CornerRadius="{StaticResource RadiusChip}"
              Background="{StaticResource BadBrush}" Opacity="0" IsHitTestVisible="False" />
      <StackPanel Orientation="Horizontal" Margin="{StaticResource ChipPadding}">
        <Grid Width="{StaticResource SpinnerSize}" Height="{StaticResource SpinnerSize}" Margin="0,0,6,0"
              VerticalAlignment="Center">
          <Ellipse x:Name="dot" Width="{StaticResource ChipDotSize}" Height="{StaticResource ChipDotSize}"
                   Fill="{StaticResource TextMutedBrush}" />
          <Ellipse x:Name="spinner" Style="{StaticResource ChipSpinner}" Visibility="Collapsed">
            <Ellipse.RenderTransform>
              <RotateTransform x:Name="spinnerTurn" Angle="0" />
            </Ellipse.RenderTransform>
          </Ellipse>
        </Grid>
        <TextBlock x:Name="label" Text="{Binding StateText, NotifyOnTargetUpdated=True}"
                   FontSize="{StaticResource FontSizeChip}"
                   FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <!-- fires on first show and on every state change -->
      <EventTrigger RoutedEvent="Binding.TargetUpdated" SourceName="label">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="chipRoot" Storyboard.TargetProperty="Opacity"
                             From="0.15" To="1" Duration="{StaticResource MotionBase}"
                             EasingFunction="{StaticResource EaseOut}" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>

      <DataTrigger Binding="{Binding StatusKind}" Value="connected">
        <Setter TargetName="chip" Property="Background" Value="{StaticResource GoodSoftBrush}" />
        <Setter TargetName="dot" Property="Fill" Value="{StaticResource GoodBrush}" />
        <Setter TargetName="label" Property="Foreground" Value="{StaticResource GoodBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="hub">
        <Setter TargetName="dot" Property="Fill" Value="{StaticResource GoodBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="disabled">
        <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="error">
        <Setter TargetName="chip" Property="Background" Value="{StaticResource BadSoftBrush}" />
        <Setter TargetName="dot" Property="Fill" Value="{StaticResource BadBrush}" />
        <Setter TargetName="label" Property="Foreground" Value="{StaticResource BadBrush}" />
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="pulseSb">
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetName="pulse" Storyboard.TargetProperty="Opacity"
                               From="0" To="0.4" Duration="{StaticResource MotionPulse}"
                               EasingFunction="{StaticResource EaseInOut}" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="pulseSb" />
        </DataTrigger.ExitActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="busy">
        <Setter TargetName="dot" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="spinner" Property="Visibility" Value="Visible" />
        <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter TargetName="label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="spin">
            <Storyboard RepeatBehavior="Forever">
              <DoubleAnimation Storyboard.TargetName="spinnerTurn" Storyboard.TargetProperty="Angle"
                               From="0" To="360" Duration="0:0:1.1" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="spin" />
        </DataTrigger.ExitActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ===================== port tile ===================== -->
  <!-- Layout (16px padding): icon well left · bold name (max 2 lines) with the tracked-out
       port label underneath · on/off switch top-right · status chip bottom-left.
       Depth: vertical gradient, 6% top highlight, soft shadow. Hover: lifts 2px, stronger
       shadow, 35% accent hairline. Selected: 2px 70% accent ring + soft glow.
       Enabled: 3px accent left edge. Error: red left edge. Disabled: 50% and desaturated. -->

  <DataTemplate x:Key="PortTile">
    <!-- outer wrapper: only the appear animation touches it (fade + scale in) -->
    <Grid x:Name="intro" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="introScale" ScaleX="1" ScaleY="1" />
      </Grid.RenderTransform>

      <Grid x:Name="root" MinHeight="{StaticResource TileMinHeight}" Background="Transparent">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="lift" Y="0" />
        </Grid.RenderTransform>
        <Grid.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{Binding OpenEditorCommand}" />
        </Grid.InputBindings>

        <Border x:Name="card" CornerRadius="{StaticResource RadiusTile}" Padding="{StaticResource TilePadding}"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
          <Border.Effect>
            <DropShadowEffect x:Name="shadow" Color="{StaticResource ShadowColor}" Direction="270"
                              BlurRadius="{StaticResource TileShadowBlur}"
                              ShadowDepth="{StaticResource TileShadowDepth}"
                              Opacity="{StaticResource TileShadowOpacity}" />
          </Border.Effect>
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop x:Name="fillTop" Color="{StaticResource TileTopColor}" Offset="0" />
              <GradientStop x:Name="fillBottom" Color="{StaticResource TileBottomColor}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ContentControl ContentTemplate="{StaticResource IconWell}" Content="{Binding}"
                              Margin="0,0,12,0" Focusable="False">
                <ContentControl.Style>
                  <Style TargetType="ContentControl">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                        <Setter Property="VerticalAlignment" Value="Center" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ContentControl.Style>
              </ContentControl>

              <!-- hubs and empty ports have no switch, so the Auto column collapses to zero
                   and the name uses that space -->
              <StackPanel Grid.Column="1">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                        <Setter Property="VerticalAlignment" Value="Center" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding DeviceName}" ToolTip="{Binding DeviceNameFull}"
                           FontSize="{StaticResource FontSizeName}" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineHeight="{StaticResource NameLineHeight}" LineStackingStrategy="BlockLineHeight"
                           MaxHeight="{StaticResource NameMaxHeight}"
                           Foreground="{StaticResource TextBrush}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding PortCaption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeMicro}"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>

              <ToggleButton x:Name="toggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                            VerticalAlignment="Top" Margin="8,2,0,0"
                            IsChecked="{Binding IsOn, Mode=OneWay}"
                            Command="{Binding ToggleCommand}"
                            Visibility="{Binding HasToggle, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding ToggleTooltip}" />
            </Grid>

            <ContentControl Grid.Row="1" Margin="0,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Content="{Binding}" ContentTemplate="{StaticResource StatusChip}"
                            Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}" />
          </Grid>
        </Border>

        <!-- 1px inner highlight along the top edge -->
        <Border x:Name="highlight" Height="1" VerticalAlignment="Top" Margin="12,1,12,0"
                Background="{StaticResource TileHighlightBrush}" IsHitTestVisible="False" />

        <!-- active-state edge: accent while enabled, red on error -->
        <Border x:Name="edge" Width="3" HorizontalAlignment="Left" Margin="0,14"
                CornerRadius="0,2,2,0" Background="{DynamicResource AccentSelectBrush}"
                Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- empty port: dim the card and outline it with a dashed border -->
        <Border x:Name="emptyCover" CornerRadius="{StaticResource RadiusTile}" Background="{StaticResource BgBrush}"
                Opacity="0.55" IsHitTestVisible="False"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
        <Rectangle x:Name="dash" RadiusX="{StaticResource RadiusTileValue}" RadiusY="{StaticResource RadiusTileValue}"
                   Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1" StrokeDashArray="4 3"
                   IsHitTestVisible="False"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <!-- hover / selection rings (overlays, so the layout never shifts) -->
        <Border x:Name="hoverRing" CornerRadius="{StaticResource RadiusTile}" BorderThickness="1"
                BorderBrush="{DynamicResource AccentHoverBrush}" Opacity="0" IsHitTestVisible="False" />
        <Border x:Name="selRing" CornerRadius="{StaticResource RadiusTile}" BorderThickness="2"
                BorderBrush="{DynamicResource AccentSelectBrush}" Effect="{DynamicResource AccentSelectGlowEffect}"
                Opacity="0" IsHitTestVisible="False" />
      </Grid>
    </Grid>

    <DataTemplate.Triggers>
      <Trigger SourceName="root" Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="hoverRing" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                               To="{StaticResource TileLift}" Duration="{StaticResource MotionFast}"
                               EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius"
                               To="{StaticResource TileShadowBlurHover}" Duration="{StaticResource MotionFast}"
                               EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth"
                               To="{StaticResource TileShadowDepthHover}" Duration="{StaticResource MotionFast}"
                               EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity"
                               To="{StaticResource TileShadowOpacityHover}" Duration="{StaticResource MotionFast}"
                               EasingFunction="{StaticResource EaseOut}" />
              <ColorAnimation Storyboard.TargetName="fillTop" Storyboard.TargetProperty="Color"
                              To="{StaticResource TileTopHoverColor}" Duration="{StaticResource MotionFast}" />
              <ColorAnimation Storyboard.TargetName="fillBottom" Storyboard.TargetProperty="Color"
                              To="{StaticResource TileBottomHoverColor}" Duration="{StaticResource MotionFast}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="hoverRing" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y"
                               To="0" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius"
                               To="{StaticResource TileShadowBlur}" Duration="{StaticResource MotionFast}"
                               EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth"
                               To="{StaticResource TileShadowDepth}" Duration="{StaticResource MotionFast}"
                               EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity"
                               To="{StaticResource TileShadowOpacity}" Duration="{StaticResource MotionFast}"
                               EasingFunction="{StaticResource EaseOut}" />
              <ColorAnimation Storyboard.TargetName="fillTop" Storyboard.TargetProperty="Color"
                              To="{StaticResource TileTopColor}" Duration="{StaticResource MotionFast}" />
              <ColorAnimation Storyboard.TargetName="fillBottom" Storyboard.TargetProperty="Color"
                              To="{StaticResource TileBottomColor}" Duration="{StaticResource MotionFast}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>

      <!-- enabled: accent-tinted left edge; error (later, so it wins): red edge -->
      <DataTrigger Binding="{Binding IsOn}" Value="True">
        <Setter TargetName="edge" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsProblem}" Value="True">
        <Setter TargetName="edge" Property="Visibility" Value="Visible" />
        <Setter TargetName="edge" Property="Background" Value="{StaticResource BadBrush}" />
        <Setter TargetName="toggle" Property="Opacity" Value="0.4" />
      </DataTrigger>

      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="selRing" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="selRing" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
      </DataTrigger>

      <!-- disabled: 50% opacity, no glow (the switch is off, so there is no bloom) -->
      <DataTrigger Binding="{Binding IsDisabled}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                               To="{StaticResource DisabledOpacity}" Duration="{StaticResource MotionFast}"
                               EasingFunction="{StaticResource EaseOut}" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
      </DataTrigger>

      <!-- empty ports sit flat: no shadow -->
      <DataTrigger Binding="{Binding IsEmpty}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>

      <!-- a device that just appeared fades and scales in -->
      <DataTrigger Binding="{Binding Appeared}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard FillBehavior="Stop">
              <DoubleAnimation Storyboard.TargetName="intro" Storyboard.TargetProperty="Opacity"
                               From="0" To="1" Duration="{StaticResource MotionSlow}"
                               EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="introScale" Storyboard.TargetProperty="ScaleX"
                               From="{StaticResource IntroScaleFrom}" To="1" Duration="{StaticResource MotionSlow}"
                               EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="introScale" Storyboard.TargetProperty="ScaleY"
                               From="{StaticResource IntroScaleFrom}" To="1" Duration="{StaticResource MotionSlow}"
                               EasingFunction="{StaticResource EaseOut}" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
