<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ============================================================================
       THEME.XAML — the single source of truth for every color, brush, spacing
       value, corner radius, size and font in the app UI. Nothing else in the app
       hard-codes a value; Controls (Dark.xaml), Tiles.xaml and the windows only
       reference the keys below.

       Design rule: color is for meaning only.
         accent    = on / selected (live, swapped per palette by Accents.cs)
         green     = connected        amber = warning        red = error ONLY

       Accent resources (AccentBrush / AccentSoftBrush (20%) / AccentLineBrush (40%) /
       AccentDimBrush / AccentGlowBrush / AccentGlowEffect / AccentGlowStrongEffect)
       are rebuilt frozen on every palette switch. WPF forbids DynamicResource inside
       Freezables, so consumers reference them with DynamicResource on a property
       or setter only — never inside a brush or effect.
       ============================================================================ -->

  <!-- ===================== colors ===================== -->

  <!-- surfaces -->
  <Color x:Key="BgColor">#FF0B0D10</Color>
  <Color x:Key="SurfaceColor">#FF14171C</Color>
  <Color x:Key="RaisedColor">#FF1B1F26</Color>
  <Color x:Key="BorderColor">#FF252A33</Color>
  <Color x:Key="BorderStrongColor">#FF363D49</Color>

  <!-- text -->
  <Color x:Key="TextPrimaryColor">#FFE8EAED</Color>
  <Color x:Key="TextDimColor">#FF9AA3AE</Color>
  <Color x:Key="TextMutedColor">#FF5F6873</Color>
  <Color x:Key="TextOnAccentColor">#FF0B0D10</Color>

  <!-- status (device state only, never chrome) -->
  <Color x:Key="GoodColor">#FF3DD68C</Color>

  <!-- Porthole brand: mint, reserved ONLY for "this profile is active" — never reused as a
       general status color, even though it sits near GoodColor on the wheel. -->
  <Color x:Key="ProfileActiveColor">#FF46E3A0</Color>
  <Color x:Key="WarnColor">#FFF5A524</Color>
  <Color x:Key="BadColor">#FFF0506E</Color>

  <!-- status chip fills: state color at ~14% over the surface -->
  <Color x:Key="GoodSoftColor">#243DD68C</Color>
  <Color x:Key="WarnSoftColor">#24F5A524</Color>
  <Color x:Key="BadSoftColor">#24F0506E</Color>
  <Color x:Key="NeutralSoftColor">#18FFFFFF</Color>

  <!-- tile depth: a faint vertical gradient (raised a touch on hover), a 6% top highlight, soft shadow -->
  <Color x:Key="TileTopColor">#FF161A20</Color>
  <Color x:Key="TileBottomColor">#FF12151A</Color>
  <Color x:Key="TileTopHoverColor">#FF1D222A</Color>
  <Color x:Key="TileBottomHoverColor">#FF171B21</Color>
  <Color x:Key="TileHighlightColor">#0FFFFFFF</Color>
  <Color x:Key="ShadowColor">#FF000000</Color>

  <!-- toggle switch: on = live accent, off = muted gray -->
  <Color x:Key="ToggleOffColor">#FF3A414C</Color>

  <!-- ===================== brushes ===================== -->

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />

  <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
  <SolidColorBrush x:Key="ProfileActiveBrush" Color="{StaticResource ProfileActiveColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />
  <SolidColorBrush x:Key="GoodSoftBrush" Color="{StaticResource GoodSoftColor}" />
  <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}" />
  <SolidColorBrush x:Key="BadSoftBrush" Color="{StaticResource BadSoftColor}" />
  <SolidColorBrush x:Key="NeutralSoftBrush" Color="{StaticResource NeutralSoftColor}" />

  <SolidColorBrush x:Key="ToggleOffBrush" Color="{StaticResource ToggleOffColor}" />

  <!-- 1px inner highlight along the top edge of a tile, fading out at both ends -->
  <LinearGradientBrush x:Key="TileHighlightBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00FFFFFF" Offset="0" />
    <GradientStop Color="{StaticResource TileHighlightColor}" Offset="0.5" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- ===================== typography ===================== -->

  <FontFamily x:Key="FontBody">Segoe UI Variable, Segoe UI</FontFamily>
  <!-- Porthole brand fonts (Bricolage Grotesque / Space Mono); both fall through to the
       previous choices when not installed, since the kit ships no font files to embed. -->
  <FontFamily x:Key="FontHeading">Bricolage Grotesque, Bricolage Grotesque SemiBold, Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>
  <FontFamily x:Key="FontMono">Space Mono, Cascadia Mono, Consolas</FontFamily>

  <sys:Double x:Key="FontSizeTitle">15</sys:Double>
  <sys:Double x:Key="FontSizeName">16</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeControl">13</sys:Double>
  <sys:Double x:Key="FontSizeSecondary">12</sys:Double>
  <sys:Double x:Key="FontSizeMeta">12</sys:Double>
  <sys:Double x:Key="FontSizeMicro">11</sys:Double>
  <sys:Double x:Key="FontSizeChip">11</sys:Double>
  <sys:Double x:Key="FontSizeHeading">13</sys:Double>
  <sys:Double x:Key="FontSizeStat">24</sys:Double>
  <sys:Double x:Key="FontSizeStatLabel">10</sys:Double>
  <!-- tight two-line device name: 19px lines, capped at two -->
  <sys:Double x:Key="NameLineHeight">19</sys:Double>
  <sys:Double x:Key="NameMaxHeight">38</sys:Double>

  <!-- ===================== spacing scale (4 · 8 · 12 · 16 · 24 · 32) ===================== -->

  <sys:Double x:Key="Space4">4</sys:Double>
  <sys:Double x:Key="Space8">8</sys:Double>
  <sys:Double x:Key="Space12">12</sys:Double>
  <sys:Double x:Key="Space16">16</sys:Double>
  <sys:Double x:Key="Space24">24</sys:Double>
  <sys:Double x:Key="Space32">32</sys:Double>

  <Thickness x:Key="PagePadding">24,24,16,24</Thickness>
  <Thickness x:Key="TilePadding">16,16,16,10</Thickness>
  <Thickness x:Key="EditorPadding">16</Thickness>
  <Thickness x:Key="SettingsPadding">24</Thickness>
  <Thickness x:Key="ToolbarPadding">16,0</Thickness>
  <Thickness x:Key="StatusbarPadding">16,0</Thickness>
  <Thickness x:Key="ControlPadding">14,7</Thickness>
  <Thickness x:Key="SegmentPadding">14,6</Thickness>
  <Thickness x:Key="FieldPadding">10,7</Thickness>
  <Thickness x:Key="ComboPadding">12,7</Thickness>
  <Thickness x:Key="ComboItemPadding">10,7</Thickness>
  <Thickness x:Key="MenuItemPadding">12,7</Thickness>
  <Thickness x:Key="TooltipPadding">10,6</Thickness>
  <Thickness x:Key="ChipPadding">8,3</Thickness>
  <Thickness x:Key="SectionGap">0,0,0,24</Thickness>
  <Thickness x:Key="StatBandPadding">24,14</Thickness>

  <!-- ===================== corner radii: 10 tiles, 8 controls ===================== -->

  <CornerRadius x:Key="RadiusTile">10</CornerRadius>
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <CornerRadius x:Key="RadiusSegment">6</CornerRadius>
  <CornerRadius x:Key="RadiusChip">10</CornerRadius>
  <CornerRadius x:Key="RadiusPill">16</CornerRadius>
  <CornerRadius x:Key="RadiusToggle">10</CornerRadius>
  <CornerRadius x:Key="RadiusBar">1.5</CornerRadius>
  <sys:Double x:Key="RadiusTileValue">10</sys:Double>

  <!-- ===================== sizes ===================== -->

  <sys:Double x:Key="ToolbarHeight">56</sys:Double>
  <sys:Double x:Key="StatusbarHeight">32</sys:Double>
  <sys:Double x:Key="EditorWidth">340</sys:Double>
  <sys:Double x:Key="EditorRailWidth">44</sys:Double>

  <!-- responsive grid: tiles stretch to fill each row, never narrower than the minimum -->
  <sys:Double x:Key="TileMinWidth">280</sys:Double>
  <sys:Double x:Key="TileMaxWidth">720</sys:Double>
  <sys:Double x:Key="TileMinHeight">102</sys:Double>
  <!-- the free-form panel canvas snaps to a fixed tile size owned by PanelLayoutMath -->
  <sys:Double x:Key="TileWidthFixed">238</sys:Double>
  <sys:Double x:Key="PanelCanvasWidth">1400</sys:Double>
  <sys:Double x:Key="PanelCanvasHeight">900</sys:Double>

  <sys:Double x:Key="IconWellSize">48</sys:Double>
  <sys:Double x:Key="EmptyStateGlyphSize">64</sys:Double>
  <sys:Double x:Key="EmptyStateRingSize">120</sys:Double>
  <sys:Double x:Key="TypeGlyphSize">24</sys:Double>
  <sys:Double x:Key="ToolbarGlyphSize">18</sys:Double>
  <sys:Double x:Key="IconButtonSize">36</sys:Double>
  <sys:Double x:Key="PhotoThumbSize">96</sys:Double>

  <sys:Double x:Key="ToggleWidth">36</sys:Double>
  <sys:Double x:Key="ToggleHeight">20</sys:Double>
  <sys:Double x:Key="ToggleThumbSize">14</sys:Double>
  <sys:Double x:Key="ToggleThumbTravel">16</sys:Double>
  <Thickness x:Key="ToggleThumbInset">3</Thickness>

  <sys:Double x:Key="AccentBarWidth">3</sys:Double>
  <sys:Double x:Key="AccentBarHeight">14</sys:Double>
  <sys:Double x:Key="ChipDotSize">6</sys:Double>
  <sys:Double x:Key="SpinnerSize">10</sys:Double>
  <sys:Double x:Key="ScrollBarThickness">10</sys:Double>
  <!-- the 6px thumb sits centered in the 10px overlay track -->
  <Thickness x:Key="ScrollBarInsetVertical">2,0</Thickness>
  <Thickness x:Key="ScrollBarInsetHorizontal">0,2</Thickness>
  <sys:Double x:Key="SettingsSwatchSize">30</sys:Double>
  <sys:Double x:Key="SettingsDialogWidth">460</sys:Double>
  <sys:Double x:Key="PromptDialogWidth">380</sys:Double>
  <sys:Double x:Key="ProfileBoxWidth">184</sys:Double>

  <!-- motion -->
  <Duration x:Key="MotionFast">0:0:0.12</Duration>
  <Duration x:Key="MotionBase">0:0:0.15</Duration>
  <Duration x:Key="MotionSlow">0:0:0.18</Duration>
  <Duration x:Key="MotionPulse">0:0:1</Duration>
  <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
  <SineEase x:Key="EaseInOut" EasingMode="EaseInOut" />
  <sys:Double x:Key="DisabledOpacity">0.5</sys:Double>
  <sys:Double x:Key="IntroScaleFrom">0.94</sys:Double>

  <!-- tile shadow at rest (0 2 8, 35% black) and when lifted on hover -->
  <sys:Double x:Key="TileLift">-2</sys:Double>
  <sys:Double x:Key="TileShadowBlur">8</sys:Double>
  <sys:Double x:Key="TileShadowDepth">2</sys:Double>
  <sys:Double x:Key="TileShadowOpacity">0.35</sys:Double>
  <sys:Double x:Key="TileShadowBlurHover">18</sys:Double>
  <sys:Double x:Key="TileShadowDepthHover">6</sys:Double>
  <sys:Double x:Key="TileShadowOpacityHover">0.55</sys:Double>

  <!-- dotted blueprint grid behind the panel-layout canvas -->
  <DrawingBrush x:Key="PanelGridBrush" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,24,24"
                ViewboxUnits="Absolute" Viewbox="0,0,24,24">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource BorderBrush}">
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="0,0,1.5,1.5" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

</ResourceDictionary>
