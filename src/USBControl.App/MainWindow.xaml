<Window x:Class="USBControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:USBControl.App.Services"
        Title="USB Control" Height="720" Width="1140" MinHeight="560" MinWidth="900"
        Icon="Assets/usb.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{StaticResource BgBrush}">

  <Window.Resources>
    <svc:PhotoConverter x:Key="PhotoConverter" />
    <svc:BoolToVisibilityConverter x:Key="BoolToVis" />
    <svc:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />

    <!-- One shared port tile, used by both the grouped view and the panel canvas -->
    <DataTemplate x:Key="PortTileBorder">
      <Border Width="238" CornerRadius="10" Padding="12"
              Background="{StaticResource CardBrush}"
              BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}" />
                <Setter Property="Effect" Value="{DynamicResource AccentGlowEffect}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter Property="BorderBrush" Value="#FF2E5E49" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsProblem}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                <Setter Property="Opacity" Value="0.62" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenEditorCommand}" />
        </Border.InputBindings>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- icon badge: device photo if set, else type glyph -->
            <Border Width="50" Height="50" CornerRadius="9" Background="{StaticResource FieldBrush}"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                    Margin="0,0,10,0">
              <Grid>
                <Image Source="{Binding PhotoPath, Converter={StaticResource PhotoConverter}}"
                       Stretch="Uniform" Margin="3" />
                <TextBlock Text="{Binding DeviceIconText}" FontSize="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}" />
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding PortTitle}" FontSize="11"
                         Foreground="{StaticResource TextDimBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding DeviceName}" FontSize="13.5" FontWeight="SemiBold"
                         TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                         MaxHeight="40" />
              <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                         FontFamily="Consolas"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{StaticResource TextDimBrush}" Margin="0,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <Button Style="{StaticResource PowerButton}"
                      ToolTip="Enable / disable (like Device Manager) — red disables, green re-enables"
                      Command="{Binding ToggleCommand}" />
            </StackPanel>
          </Grid>

          <!-- HUD status chip row -->
          <Border Margin="0,9,0,0">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource HudChipBorder}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter Property="BorderBrush" Value="#55E2574A" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter Property="BorderBrush" Value="#55EDB44A" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsHub}" Value="True">
                    <Setter Property="BorderBrush" Value="#554CC2FF" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Ellipse Margin="0,0,5,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse" BasedOn="{StaticResource HudChipDot}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsProblem}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsHub}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding StateText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource HudChipLabel}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsProblem}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsHub}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding HubName}" FontSize="10"
                     Foreground="{StaticResource TextDimBrush}"
                     Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- ===================== top bar (accent-tinted gradient) ===================== -->
    <Border DockPanel.Dock="Top" Background="{StaticResource TopbarBrush}" Padding="14,9"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <!-- accent wash layer -->
        <Border Background="{DynamicResource TopbarGradient}" IsHitTestVisible="False" />
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
            <TextBlock Text="⚡ USB CONTROL" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
            <Border Width="3" Height="16" Background="{DynamicResource AccentBrush}"
                    CornerRadius="1.5" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="⟳  Refresh" Command="{Binding RefreshCommand}" />
            <ToggleButton IsChecked="{Binding Controller.ShowAllDevices}" Margin="6,0,0,0"
                          ToolTip="Show every USB device (not just controllers/hubs)"
                          Content="All devices" />
            <ToggleButton IsChecked="{Binding Controller.ShowEmptyPorts}" Margin="6,0,0,0"
                          ToolTip="Show ports with nothing plugged in"
                          Content="Empty ports" />
            <ToggleButton IsChecked="{Binding Controller.ShowHiddenPorts}" Margin="6,0,0,0"
                          ToolTip="Show ports you hid"
                          Content="Hidden" />
            <ToggleButton Margin="14,0,0,0" IsChecked="{Binding Controller.IsPanelMode}"
                          ToolTip="Rear-panel view: drag tiles to mirror the physical ports on your case">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🖥 " />
                <TextBlock Text="Panel layout" />
              </StackPanel>
            </ToggleButton>
            <Button Content="Reset panel" Margin="6,0,0,0" Command="{Binding ResetPanelLayoutCommand}"
                    ToolTip="Forget all dragged positions"
                    Visibility="{Binding Controller.IsPanelMode, Converter={StaticResource BoolToVis}}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <ComboBox x:Name="ProfileBox" ItemsSource="{Binding Controller.ProfileList}"
                      SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                      MinWidth="170" VerticalAlignment="Center" />
            <Button Content="Apply" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ApplyProfileCommand}" />
            <Button Content="Save current as…" Margin="6,0,0,0" Command="{Binding CaptureProfileCommand}" />
            <Button Content="🗑" Margin="6,0,0,0" ToolTip="Delete selected profile"
                    Command="{Binding DeleteProfileCommand}" />
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>

    <!-- ===================== status bar ===================== -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource TopbarBrush}" Padding="14,7"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="⚙  Settings…" Command="{Binding OpenSettingsCommand}"
                VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal">
          <Ellipse Style="{StaticResource BusySpinner}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}"
                     VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===================== main content ===================== -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- auto view (grouped by hub) -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,8,12"
                    Visibility="{Binding Controller.IsPanelMode, Converter={StaticResource InverseBoolToVis}}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Controller.Hubs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4,0,16">
                  <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                    <Border Width="3" Height="13" Background="{DynamicResource AccentBrush}"
                            CornerRadius="1.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="9,0,0,0"
                               Typography.Capitals="AllSmallCaps" />
                    <TextBlock FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="Consolas"
                               Foreground="{StaticResource TextDimBrush}">
                      <Run Text="{Binding PortCount, Mode=OneWay}" />
                      <Run Text="ports" />
                    </TextBlock>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ContentControl ContentTemplate="{StaticResource PortTileBorder}"
                                        Margin="0,0,10,10" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- empty state -->
          <StackPanel HorizontalAlignment="Center" Margin="0,60,0,0"
                      Visibility="{Binding HasNoHubs, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="🔌" FontSize="42" HorizontalAlignment="Center" Opacity="0.5" />
            <TextBlock Text="No USB ports found yet" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
            <TextBlock Text="The app runs elevated (Device-Manager rights) — accept the prompt, then hit Refresh."
                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"
                       Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- panel view (free-form rear-panel layout) -->
      <Grid Visibility="{Binding Controller.IsPanelMode, Converter={StaticResource BoolToVis}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="16,10,16,4" FontSize="11.5"
                   Foreground="{StaticResource TextDimBrush}"
                   Text="Drag tiles to mirror your case's rear panel. Layout is saved automatically. Double-click still opens the editor." />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Padding="14,4,8,10">
          <Canvas Width="1400" Height="900" Background="{StaticResource PanelGridBrush}">
            <ItemsControl ItemsSource="{Binding Controller.PanelPorts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Canvas.Left" Value="{Binding LayoutX}" />
                  <Setter Property="Canvas.Top" Value="{Binding LayoutY}" />
                  <Setter Property="Width" Value="238" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ContentControl svc:PanelDrag.Enabled="True"
                                  ContentTemplate="{StaticResource PortTileBorder}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Canvas>
        </ScrollViewer>
      </Grid>

      <!-- ===================== device editor panel ===================== -->
      <Border Grid.Column="1" Width="290" Margin="8,12,14,12" Padding="16"
              Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              CornerRadius="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding SelectedPort}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Border Width="3" Height="13" Background="{DynamicResource AccentBrush}"
                      CornerRadius="1.5" VerticalAlignment="Center" />
              <TextBlock Text="DEVICE EDITOR" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}" Margin="9,0,0,0"
                         Typography.Capitals="AllSmallCaps" />
            </StackPanel>

            <TextBlock Text="PORT LABEL" Foreground="{StaticResource TextDimBrush}" FontSize="10.5" />
            <TextBox Text="{Binding EditPortLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="DEVICE NAME (YOURS)" Foreground="{StaticResource TextDimBrush}" FontSize="10.5" />
            <TextBox Text="{Binding EditDeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
            <TextBlock Text="NOTE" Foreground="{StaticResource TextDimBrush}" FontSize="10.5" />
            <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"
                     AcceptsReturn="True" Height="56" />
            <Button Content="Choose photo…" Command="{Binding PickPhotoCommand}" HorizontalAlignment="Left" />
            <Border Height="10" />
            <Border CornerRadius="8" Background="{StaticResource FieldBrush}" Height="130"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
              <Image Source="{Binding PhotoPath, Converter={StaticResource PhotoConverter}}" Stretch="Uniform" />
            </Border>
            <Button Content="Remove photo" Margin="0,10,0,0" Command="{Binding ClearPhotoCommand}"
                    HorizontalAlignment="Left" />
            <Separator Margin="0,12,0,0" Background="{StaticResource BorderBrush}" />
            <TextBlock Text="{Binding Subtitle}" FontSize="11" FontFamily="Consolas"
                       Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock Text="{Binding InstanceId}" FontSize="10" FontFamily="Consolas"
                       Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
