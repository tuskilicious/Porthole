<Window x:Class="USBControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:USBControl.App.Services"
        Title="USB Control" Height="720" Width="1140" MinHeight="560" MinWidth="900"
        Icon="Assets/usb.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{StaticResource BgBrush}">

  <Window.Resources>
    <svc:PhotoConverter x:Key="PhotoConverter" />
    <svc:BoolToVisibilityConverter x:Key="BoolToVis" />
    <svc:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />

    <!-- One shared port tile, used by both the grouped view and the panel canvas -->
    <DataTemplate x:Key="PortTileBorder">
      <Border Width="238" CornerRadius="10" Padding="12"
              Background="{StaticResource CardBrush}"
              BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter Property="BorderBrush" Value="#FF2E5E49" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsProblem}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                <Setter Property="Opacity" Value="0.6" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenEditorCommand}" />
        </Border.InputBindings>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="8" Background="#FF14161B"
                    Margin="0,0,10,0">
              <Grid>
                <Image Source="{Binding PhotoPath, Converter={StaticResource PhotoConverter}}"
                       Stretch="Uniform" />
                <TextBlock Text="🔌" FontSize="24" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding PortTitle}" FontSize="12"
                         Foreground="{StaticResource TextDimBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding DeviceName}" FontSize="13.5" FontWeight="SemiBold"
                         TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                         MaxHeight="40" />
              <TextBlock Text="{Binding StateText}" FontSize="11.5"
                         Foreground="{StaticResource TextDimBrush}" />
              <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{StaticResource TextDimBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <Button Style="{StaticResource PowerButton}"
                      ToolTip="Enable / disable (like Device Manager) — red disables, green re-enables"
                      Command="{Binding ToggleCommand}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding HubName}" FontSize="10"
                     Foreground="{StaticResource TextDimBrush}"
                     Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- ===================== toolbar ===================== -->
    <Border DockPanel.Dock="Top" Background="#FF111318" Padding="12,8"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <TextBlock Text="⚡ USB Control" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" />
          <Button Content="Show all devices" Margin="6,0,0,0" Command="{Binding ToggleShowAllCommand}" />
          <Button Content="Show empty ports" Margin="6,0,0,0" Command="{Binding ToggleShowEmptyCommand}" />
          <Button Content="Show hidden" Margin="6,0,0,0" Command="{Binding ToggleShowHiddenCommand}" />
          <ToggleButton Margin="14,0,0,0" IsChecked="{Binding Controller.IsPanelMode}"
                        ToolTip="Rear-panel view: drag tiles to mirror the physical ports on your case">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🖥 " />
              <TextBlock Text="Panel layout" />
            </StackPanel>
          </ToggleButton>
          <Button Content="Reset panel" Margin="6,0,0,0" Command="{Binding ResetPanelLayoutCommand}"
                  ToolTip="Forget all dragged positions"
                  Visibility="{Binding Controller.IsPanelMode, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
          <ComboBox x:Name="ProfileBox" ItemsSource="{Binding Controller.ProfileList}"
                    SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                    MinWidth="160" VerticalAlignment="Center" />
          <Button Content="Apply" Margin="6,0,0,0" Command="{Binding ApplyProfileCommand}" />
          <Button Content="Save current as…" Margin="6,0,0,0" Command="{Binding CaptureProfileCommand}" />
          <Button Content="🗑" Margin="6,0,0,0" ToolTip="Delete selected profile"
                  Command="{Binding DeleteProfileCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===================== status bar ===================== -->
    <Border DockPanel.Dock="Bottom" Background="#FF111318" Padding="12,6"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Settings…" Command="{Binding OpenSettingsCommand}"
                VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="9" Height="9" Margin="0,0,7,0">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===================== main content ===================== -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- auto view (grouped by hub) -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,6,10"
                    Visibility="{Binding Controller.IsPanelMode, Converter={StaticResource InverseBoolToVis}}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Controller.Hubs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4,0,14">
                  <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                    <Border Width="3" Height="14" Background="{StaticResource AccentBrush}"
                            CornerRadius="1.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="8,0,0,0" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ContentControl ContentTemplate="{StaticResource PortTileBorder}"
                                        Margin="0,0,10,10" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="No USB ports found yet — the app runs elevated (Device-Manager rights), so accept the prompt and hit Refresh."
                     Foreground="{StaticResource TextDimBrush}" Margin="2,10,0,0" TextWrapping="Wrap"
                     Visibility="{Binding HasNoHubs, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </ScrollViewer>

      <!-- panel view (free-form rear-panel layout) -->
      <Grid Visibility="{Binding Controller.IsPanelMode, Converter={StaticResource BoolToVis}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="14,10,14,4" FontSize="11.5"
                   Foreground="{StaticResource TextDimBrush}"
                   Text="Drag tiles to mirror your case's rear panel. Layout is saved automatically. Double-click still opens the editor." />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Padding="12,4,6,10">
          <Canvas Width="1400" Height="900" Background="{StaticResource PanelGridBrush}">
            <ItemsControl ItemsSource="{Binding Controller.PanelPorts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Canvas.Left" Value="{Binding LayoutX}" />
                  <Setter Property="Canvas.Top" Value="{Binding LayoutY}" />
                  <Setter Property="Width" Value="238" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ContentControl svc:PanelDrag.Enabled="True"
                                  ContentTemplate="{StaticResource PortTileBorder}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Canvas>
        </ScrollViewer>
      </Grid>

      <!-- ===================== device editor panel ===================== -->
      <Border Grid.Column="1" Width="290" Margin="6,10,12,10" Padding="14"
              Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              CornerRadius="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding SelectedPort}">
            <TextBlock Text="Device editor" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" />
            <TextBlock Text="Port label" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
            <TextBox Text="{Binding EditPortLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
            <TextBlock Text="Device name (yours)" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
            <TextBox Text="{Binding EditDeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
            <TextBlock Text="Note" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
            <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                     AcceptsReturn="True" Height="56" />
            <Button Content="Choose photo…" Command="{Binding PickPhotoCommand}" HorizontalAlignment="Left" />
            <Border Height="10" />
            <Border CornerRadius="8" Background="#FF14161B" Height="130">
              <Image Source="{Binding PhotoPath, Converter={StaticResource PhotoConverter}}" Stretch="Uniform" />
            </Border>
            <Button Content="Remove photo" Margin="0,10,0,0" Command="{Binding ClearPhotoCommand}"
                    HorizontalAlignment="Left" />
            <Separator Margin="0,10,0,0" Background="{StaticResource BorderBrush}" />
            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="{Binding InstanceId}" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
